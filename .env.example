# --- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=sk-proj-replace-me
# Pin exact, dated model snapshots — floating aliases change behaviour silently.
OPENAI_MODEL=gpt-5.1-2025-11-13
OPENAI_MODEL_FAST=gpt-5-mini-2025-08-07
OPENAI_MONTHLY_BUDGET_USD=50
# USD per 1M tokens, used to estimate cost of every call (check current pricing).
OPENAI_MODEL_INPUT_USD_PER_1M=1.25
OPENAI_MODEL_OUTPUT_USD_PER_1M=10
OPENAI_MODEL_FAST_INPUT_USD_PER_1M=0.25
OPENAI_MODEL_FAST_OUTPUT_USD_PER_1M=2

# --- Chrome (first contact) ---------------------------------------------
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PROFILE_DIR=./.chrome-profile
INSTAGRAM_WEB_URL=https://www.instagram.com

# --- Instagram official API (after the lead replies) ---------------------
INSTAGRAM_APP_SECRET=replace-me
INSTAGRAM_PAGE_ACCESS_TOKEN=replace-me
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=replace-me
INSTAGRAM_BUSINESS_ACCOUNT_ID=replace-me
INSTAGRAM_GRAPH_API_URL=https://graph.facebook.com/v23.0

# --- Storage --------------------------------------------------------------
DATABASE_URL=./data/app.db
BACKUP_DIR=./backups
ARTIFACTS_DIR=./artifacts
# 32 bytes, base64. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=replace-with-32-bytes-base64

# --- Pacing (account health) ----------------------------------------------
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Sao_Paulo

# Set to true only after the operator explicitly authorises real sends.
BROWSER_SEND_ENABLED=false
